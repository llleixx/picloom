{
  "id": "picloom.horizon",
  "version": "1.4.0",
  "apiVersion": 1,
  "pages": {
    "home": {
      "entry": "entry.js"
    },
    "login": {
      "entry": "entry.js"
    }
  },
  "styles": ["style.css"],
  "configSchema": {
    "type": "object",
    "properties": {
      "heading": {
        "type": "string",
        "default": {
          "zh-CN": "把此刻，\n留在远空。",
          "en-US": "A little closer\nto the infinite."
        },
        "x-localized": true,
        "x-ui": {
          "labelKey": "settings.heading.title",
          "widget": "textarea"
        }
      },
      "description": {
        "type": "string",
        "default": {
          "zh-CN": "收藏每一次心动，让美好自由抵达。\n上传、分享，把你的世界留在这里。",
          "en-US": "Keep the moments that move you.\nUpload, share, and let your world travel."
        },
        "x-localized": true,
        "x-ui": {
          "labelKey": "settings.description.title",
          "widget": "textarea"
        }
      },
      "rotate": {
        "type": "boolean",
        "default": true,
        "x-ui": {
          "labelKey": "settings.rotate.title"
        }
      },
      "interval": {
        "type": "integer",
        "default": 6,
        "minimum": 5,
        "maximum": 60,
        "x-ui": {
          "labelKey": "settings.interval.title"
        }
      },
      "shade": {
        "type": "number",
        "default": 0.18,
        "minimum": 0,
        "maximum": 0.6,
        "x-ui": {
          "labelKey": "settings.shade.title"
        }
      },
      "loginHeading": {
        "type": "string",
        "x-localized": true,
        "default": {
          "en-US": "Every return,\na new beginning.",
          "zh-CN": "每一次回来，\n都是新的开始。"
        },
        "x-ui": {
          "labelKey": "settings.loginHeading.title",
          "widget": "textarea"
        }
      },
      "loginDescription": {
        "type": "string",
        "x-localized": true,
        "default": {
          "en-US": "Your moments, quietly waiting.\nSign in to pick up where you left off.",
          "zh-CN": "那些值得珍藏的瞬间，正在等你。\n登录，继续记录属于你的世界。"
        },
        "x-ui": {
          "labelKey": "settings.loginDescription.title",
          "widget": "textarea"
        }
      },
      "backgrounds": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "minLength": 1,
              "x-ui": {
                "labelKey": "settings.backgrounds.url.title",
                "descriptionKey": "settings.backgrounds.url.description"
              }
            },
            "name": {
              "type": "string",
              "x-localized": true,
              "x-ui": {
                "labelKey": "settings.backgrounds.name.title"
              }
            },
            "tone": {
              "type": "string",
              "enum": ["day", "night"],
              "default": "day",
              "x-ui": {
                "labelKey": "settings.backgrounds.tone.title",
                "enumKeys": [
                  "settings.backgrounds.tone.day",
                  "settings.backgrounds.tone.night"
                ]
              }
            }
          },
          "required": ["url"]
        },
        "default": [
          {
            "url": "assets/cloud-sea.png",
            "name": {
              "zh-CN": "云与海的交界",
              "en-US": "Where clouds meet the sea"
            },
            "tone": "day"
          },
          {
            "url": "assets/star-lake.png",
            "name": {
              "zh-CN": "一湖星光",
              "en-US": "A lake full of stars"
            },
            "tone": "night"
          },
          {
            "url": "assets/dawn-valley.png",
            "name": {
              "zh-CN": "晨光山谷",
              "en-US": "Valley of first light"
            },
            "tone": "day"
          },
          {
            "url": "assets/aurora-fjord.png",
            "name": {
              "zh-CN": "极光峡湾",
              "en-US": "Under the northern lights"
            },
            "tone": "night"
          }
        ],
        "x-ui": {
          "labelKey": "settings.backgrounds.title",
          "descriptionKey": "settings.backgrounds.description"
        }
      }
    },
    "required": ["interval", "shade", "rotate"]
  },
