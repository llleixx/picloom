{
  "id": "picloom.horizon",
  "version": "1.2.6",
  "apiVersion": 1,
  "pages": {
    "home": {
      "entry": "entry.js"
    },
    "login": {
      "entry": "entry.js"
    }
  },
  "styles": [
    "style.css"
  ],
  "configSchema": {
    "type": "object",
    "properties": {
      "heading": {
        "type": "string",
        "default": {
          "zh-CN": "把此刻，\n留在远空。",
          "en-US": "A little closer\nto the infinite."
        },
        "title": "Hero heading",
        "content": {
          "zh-CN": {
            "title": "宣传标题"
          }
        },
        "x-localized": true,
        "x-multiline": true
      },
      "description": {
        "type": "string",
        "default": {
          "zh-CN": "收藏每一次心动，让美好自由抵达。\n上传、分享，把你的世界留在这里。",
          "en-US": "Keep the moments that move you.\nUpload, share, and let your world travel."
        },
        "title": "Hero description",
        "content": {
          "zh-CN": {
            "title": "宣传说明"
          }
        },
        "x-localized": true,
        "x-multiline": true
      },
      "rotate": {
        "type": "boolean",
        "default": true,
        "title": "Rotate scenery",
        "content": {
          "zh-CN": {
            "title": "自动轮换背景"
          }
        }
      },
      "interval": {
        "type": "integer",
        "default": 6,
        "title": "Rotation interval (seconds)",
        "content": {
          "zh-CN": {
            "title": "轮换间隔（秒）"
          }
        },
        "minimum": 5,
        "maximum": 60
      },
      "shade": {
        "type": "number",
        "default": 0.18,
        "title": "Background shading",
        "content": {
          "zh-CN": {
            "title": "背景遮罩强度"
          }
        },
        "minimum": 0,
        "maximum": 0.6
      },
      "dayImage": {
        "type": "string",
        "default": "assets/cloud-sea.png",
        "title": "Cloud sea image URL",
        "content": {
          "zh-CN": {
            "title": "云海背景 URL",
            "description": "填写包内资源路径或 HTTPS 地址，清空后不显示此图片。"
          }
        },
        "description": "Package asset path or HTTPS URL. Empty disables this image."
      },
      "nightImage": {
        "type": "string",
        "default": "assets/star-lake.png",
        "title": "Star lake image URL",
        "content": {
          "zh-CN": {
            "title": "星湖背景 URL",
            "description": "填写包内资源路径或 HTTPS 地址，清空后不显示此图片。"
          }
        },
        "description": "Package asset path or HTTPS URL. Empty disables this image."
      },
      "dawnImage": {
        "type": "string",
        "default": "assets/dawn-valley.png",
        "title": "Dawn valley image URL",
        "content": {
          "zh-CN": {
            "title": "晨光山谷背景 URL",
            "description": "填写包内资源路径或 HTTPS 地址，清空后不显示此图片。"
          }
        },
        "description": "Package asset path or HTTPS URL. Empty disables this image."
      },
      "auroraImage": {
        "type": "string",
        "default": "assets/aurora-fjord.png",
        "title": "Aurora fjord image URL",
        "content": {
          "zh-CN": {
            "title": "极光峡湾背景 URL",
            "description": "填写包内资源路径或 HTTPS 地址，清空后不显示此图片。"
          }
        },
        "description": "Package asset path or HTTPS URL. Empty disables this image."
      },
      "loginHeading": {
        "type": "string",
        "x-localized": true,
        "x-multiline": true,
        "title": "Login heading",
        "content": {
          "zh-CN": {
            "title": "登录页标题"
          }
        },
        "default": {
          "en-US": "Every return,\na new beginning.",
          "zh-CN": "每一次回来，\n都是新的开始。"
        }
      },
      "loginDescription": {
        "type": "string",
        "x-localized": true,
        "x-multiline": true,
        "title": "Login description",
        "content": {
          "zh-CN": {
            "title": "登录页说明"
          }
        },
        "default": {
          "en-US": "Your moments, quietly waiting.\nSign in to pick up where you left off.",
          "zh-CN": "那些值得珍藏的瞬间，正在等你。\n登录，继续记录属于你的世界。"
        }
      }
    },
    "required": [
      "interval",
      "shade",
      "rotate"
    ]
  },
