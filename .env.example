# Local source development. Docker uses docker/.env.example instead.
# Generate once: bun -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
DATA_DIR=./data
# Empty uses SQLite at DATA_DIR/database.sqlite. PostgreSQL requires a dedicated database.
# DATABASE_URL=postgresql://picloom:password@localhost:5432/picloom
# First server start only; at least 12 characters. Blank generates and logs a random password.
# Existing accounts remain unchanged. Default Owner username: admin.
INITIAL_OWNER_PASSWORD=
# Optional site origin. Blank uses the request origin; set for background URL delivery.
PUBLIC_ORIGIN=
# Optional image origin. Falls back to PUBLIC_ORIGIN, then the request origin.
# IMAGE_ORIGIN=https://img.example.com
HOTLINK_ENABLED=false
# Exact hosts or *.example.com (subdomains only); site and image origins are always allowed.
HOTLINK_ALLOWED_HOSTS=
HOTLINK_ALLOW_EMPTY=true
# Browser/CDN freshness in seconds. 0 revalidates; positive values can retain deleted images until expiry.
IMAGE_CACHE_MAX_AGE=0
HOST=127.0.0.1
PORT=3000
MAX_UPLOAD_BYTES=20971520
# Shared upload/processing temporary bytes, including active reservations and retained task files.
UPLOAD_TEMP_BYTES=1073741824
UPLOAD_SESSION_LIMIT=100
CHUNK_THRESHOLD_BYTES=8388608
CHUNK_PART_BYTES=4194304
UPLOAD_CONCURRENCY=2
PART_CONCURRENCY=2
UPLOAD_SESSION_TTL_MS=86400000
MAX_DIMENSION=8192
MAX_PIXELS=40000000
PROCESSING_CONCURRENCY=2
PROCESSING_QUEUE=16
# Derived image bytes; evict before writing, skip oversized results.
CACHE_BYTES=1073741824
CACHE_TTL_MS=86400000
RETRY_LIMIT=5
TASK_CONCURRENCY=2

# Settings saves delivery, upload and processing/task limits in DATA_DIR/delivery-settings.json.
# Once saved, that file takes precedence over the corresponding environment defaults above.

# Exact trusted reverse-proxy IPs
TRUSTED_PROXIES=
