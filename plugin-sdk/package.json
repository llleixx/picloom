{
  "name": "@picloom/plugin-sdk",
  "version": "0.1.0",
  "description": "Public types and helpers for Picloom plugins",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/llleixx/picloom.git",
    "directory": "plugin-sdk"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun -e 'await require(\"node:fs/promises\").rm(\"dist\", {recursive: true, force: true})' && bun build ./index.ts --target=bun --format=esm --outfile=dist/index.js && bun run --bun tsc -p tsconfig.build.json",
    "prepack": "bun run build"
  },
  "peerDependencies": {
    "sharp": "^0.34.5"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "1.3.10",
    "sharp": "0.34.5",
    "typescript": "5.9.3"
  }
}
