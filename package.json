{
  "name": "picloom",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "bun src/main.ts",
    "dev": "bun --watch src/main.ts",
    "dev:web": "bun --bun vite --config web/vite.config.ts",
    "build:web": "bun --bun vite build --config web/vite.config.ts",
    "test": "bun test ./tests",
    "test:web": "playwright test",
    "test:s3": "bun test tests/s3-live.test.ts",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit -p web/tsconfig.json",
    "typecheck:web": "vue-tsc --noEmit -p web/tsconfig.json",
    "init-db": "bun src/cli.ts init-db",
    "reset-owner-password": "bun src/cli.ts reset-owner-password",
    "init-admin": "bun src/cli.ts init-admin",
    "init-dev": "bun src/cli.ts init-dev",
    "test:postgres": "REQUIRE_POSTGRES_TEST=1 bun test tests/postgres.test.ts",
    "test:plugin-tooling": "PICLOOM_TEST_PLUGIN_TOOLING=1 bun test tests/plugin-tooling.test.ts",
    "build:examples": "bun examples/build.ts",
    "test:docker": "bun docker/smoke.ts",
    "docs:dev": "bun run --cwd docs dev",
    "docs:build": "bun run --cwd docs build",
    "docs:preview": "bun run --cwd docs preview",
    "test:theme-tooling": "PICLOOM_TEST_THEME_TOOLING=1 bun test tests/theme-tooling.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1151.0",
    "@aws-sdk/s3-request-presigner": "3.1151.0",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "hash-wasm": "4.12.0",
    "kysely": "0.29.6",
    "kysely-bun-worker": "2.0.1",
    "pg": "8.23.1",
    "saxes": "6.0.0",
    "sharp": "0.34.5",
    "tar": "7.5.11",
    "@picloom/plugin-sdk": "0.2.0",
    "@picloom/package-rules": "0.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/vue-query": "5.104.2",
    "@types/bun": "1.3.10",
    "@types/pg": "8.23.1",
    "@vitejs/plugin-vue": "6.0.10",
    "@vueuse/core": "15.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-vue-next": "1.0.0",
    "prettier": "3.8.3",
    "reka-ui": "2.11.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vue": "3.5.44",
    "vue-router": "5.4.0",
    "vue-tsc": "3.3.13",
    "@picloom/theme-sdk": "0.2.0",
    "@picloom/plugin-tools": "0.1.2"
  }
}
