{
  "name": "my-theme",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.4.3"
  },
  "scripts": {
    "dev": "bun scripts/serve.ts",
    "typecheck": "bun --bun vue-tsc --noEmit",
    "build": "bun run typecheck && bun scripts/build.ts",
    "preview": "bun scripts/serve.ts --preview"
  },
  "devDependencies": {
    "@picloom/theme-sdk": "0.1.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.3.10",
    "@vitejs/plugin-vue": "6.0.10",
    "fflate": "0.8.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vue": "3.5.44",
    "vue-tsc": "3.3.13"
  }
}
