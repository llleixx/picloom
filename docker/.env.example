# Copy to docker/.env. Pass --env-file docker/.env to every Compose command.
# Required: generate 32 random bytes as 64 hex characters; keep this key across upgrades/restores.
# openssl rand -hex 32
ENCRYPTION_KEY=

# Optional: at least 12 characters. Blank prints a random Owner password on FIRST startup only.
INITIAL_OWNER_PASSWORD=

# Exact browser origin, no trailing slash. Change together with the public port/domain.
PUBLIC_ORIGIN=http://localhost:3000
HTTP_PORT=3000
# Local-only by default. Set 0.0.0.0 to expose on all host interfaces.
PUBLISH_ADDRESS=127.0.0.1
# Exact trusted reverse-proxy IPs, comma-separated; proxy must replace X-Real-IP.
TRUSTED_PROXIES=

# PostgreSQL Compose only. Use a separate random hex password (openssl rand -hex 32).
# This value is embedded in DATABASE_URL, so use URL-safe characters.
POSTGRES_PASSWORD=
